{
  "$schema": "../../../../schemas/model.schema.json",
  "id": "model.robot-chassis-2wd",
  "name": "2-wheel differential-drive chassis",
  "category": "mechanical/chassis",
  "description": "두 바퀴 축(left·right)에 모터를 붙이면 평면 위를 달리는 차체. 바퀴가 같은 방향으로 돌면 직진, 반대 방향이면 제자리 회전. 아직 특정 제품이 아니라 일반 값(전부 가정)이다. 3D에서는 가운데 판 양옆에 모터를 달 수 있고, 바퀴가 모터 각도를 따라 돌고 흰 표식으로 회전을 보인다. 바퀴 지름 66 mm·너비 26 mm는 TT 모터용 바퀴 가정.",
  "propertySchema": {
    "wheelRadius": {
      "type": "number",
      "unit": "m",
      "min": 0.001,
      "default": 0.033,
      "description": "바퀴 반지름. TT 모터용 지름 약 66 mm 바퀴 가정"
    },
    "trackWidth": {
      "type": "number",
      "unit": "m",
      "min": 0.01,
      "default": 0.13,
      "description": "좌우 바퀴 사이 거리. 가정"
    },
    "mass": {
      "type": "number",
      "unit": "kg",
      "min": 0.01,
      "default": 0.5,
      "description": "차체 총 질량. 가정"
    },
    "wheelInertia": {
      "type": "number",
      "min": 0,
      "default": 1e-5,
      "description": "바퀴 한 개 관성 [kg·m²]. 가정"
    },
    "rollingDamping": {
      "type": "number",
      "min": 0,
      "default": 6e-5,
      "description": "구름 저항을 점성 계수로 단순화 [N·m·s/rad]: 구름 저항 계수 0.02 가정 → 바퀴당 1.6 mN·m / 26 rad/s"
    }
  },
  "properties": {},
  "ports": [
    {
      "name": "left",
      "domain": "mechanical",
      "description": "왼쪽 바퀴 축"
    },
    {
      "name": "right",
      "domain": "mechanical",
      "description": "오른쪽 바퀴 축"
    },
    {
      "name": "x",
      "domain": "signal",
      "direction": "out",
      "description": "월드 x 위치 [m]"
    },
    {
      "name": "y",
      "domain": "signal",
      "direction": "out",
      "description": "월드 y 위치 [m]"
    },
    {
      "name": "heading",
      "domain": "signal",
      "direction": "out",
      "description": "방향 [rad]"
    }
  ],
  "capabilities": [
    {
      "capability": "capability.drive-base"
    }
  ],
  "metadata": {
    "fidelity": "approximate",
    "source": "일반적인 2륜 로봇 값 — 특정 제품 데이터가 아니다",
    "assumptions": [
      "wheelRadius",
      "trackWidth",
      "mass",
      "wheelInertia",
      "rollingDamping",
      "선회 관성 무시",
      "바퀴 미끄러짐 없음"
    ]
  },
  "body": {
    "size": [200, 186, 66],
    "mass": 500,
    "color": "#7a8ca8",
    "parts": [
      {
        "name": "plate",
        "shape": "box",
        "position": [0, 0, 0],
        "size": [200, 80, 30],
        "material": "plastic",
        "color": "#7a8ca8"
      },
      {
        "name": "wheel-left",
        "shape": "cylinder",
        "position": [0, -78, 0],
        "diameter": 66,
        "length": 26,
        "axis": "y",
        "material": "rubber",
        "color": "#1d1f23",
        "motion": {
          "signal": "leftAngle",
          "axis": "y",
          "rotate": true,
          "scale": 1,
          "pivot": [0, -78, 0]
        }
      },
      {
        "name": "wheel-left-mark",
        "shape": "box",
        "position": [0, -91.5, 0],
        "size": [52, 2, 10],
        "material": "plastic",
        "color": "#e6e2d3",
        "motion": {
          "signal": "leftAngle",
          "axis": "y",
          "rotate": true,
          "scale": 1,
          "pivot": [0, -78, 0]
        }
      },
      {
        "name": "wheel-right",
        "shape": "cylinder",
        "position": [0, 78, 0],
        "diameter": 66,
        "length": 26,
        "axis": "y",
        "material": "rubber",
        "color": "#1d1f23",
        "motion": {
          "signal": "rightAngle",
          "axis": "y",
          "rotate": true,
          "scale": 1,
          "pivot": [0, 78, 0]
        }
      },
      {
        "name": "wheel-right-mark",
        "shape": "box",
        "position": [0, 91.5, 0],
        "size": [52, 2, 10],
        "material": "plastic",
        "color": "#e6e2d3",
        "motion": {
          "signal": "rightAngle",
          "axis": "y",
          "rotate": true,
          "scale": 1,
          "pivot": [0, 78, 0]
        }
      }
    ]
  }
}
