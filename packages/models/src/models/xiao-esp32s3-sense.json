  "propertySchema": {
    "sleepCurrent": {
      "type": "number",
      "unit": "uA",
      "min": 0,
      "default": 8,
      "description": "딥슬립 전류. ESP32-S3 칩 8 µA(Datasheet Table 5-10). 센서는 전원 차단 가정이라 0 (OV2640을 켜 두면 +600 µA)"
    },
    "bootTime": {
      "type": "number",
      "unit": "ms",
      "min": 0,
      "default": 150,
      "description": "깨어나 부팅하는 시간"
    },
    "bootCurrent": {
      "type": "number",
      "unit": "mA",
      "min": 0,
      "default": 66,
      "description": "부팅: 240 MHz 듀얼코어 모뎀슬립 66.2 mA (Table 5-9). 부팅 시간은 미확인 가정"
    },
    "captureTime": {
      "type": "number",
      "unit": "ms",
      "min": 0,
      "default": 250,
      "description": "센서 초기화 + 촬영 + JPEG 인코딩"
    },
    "captureCurrent": {
      "type": "number",
      "unit": "mA",
      "min": 0,
      "default": 108,
      "description": "촬영: 240 MHz 듀얼코어 66 mA + OV2640 압축 활성 140 mW ≈ 42 mA (유도값). OV5640 5MP는 +140 mA. 촬영 시간은 미확인 가정"
    },
    "connectTime": {
      "type": "number",
      "unit": "ms",
      "min": 0,
      "default": 600,
      "description": "Wi-Fi 연결 (고정 IP·빠른 재연결 가정)"
    },
    "connectCurrent": {
      "type": "number",
      "unit": "mA",
      "min": 0,
      "default": 88,
      "description": "Wi-Fi 연결: RX 88 mA (Table 5-7, 하한). 연결 시간 600 ms는 미확인 가정"
    },
    "imageBytes": {
      "type": "integer",
      "min": 1,
      "default": 90000,
      "description": "JPEG 한 장 [byte]. 미확인 가정 (UXGA 약 90 kB)"
    },
    "throughput": {
      "type": "integer",
      "min": 1,
      "default": 2500000,
      "description": "실효 전송 속도 [byte/s]. 2.5 MB/s = ESP-IDF 실험실 iperf TCP TX 20 Mbit/s (실제 HTTP 업로드는 더 느림)"
    },
    "transmitCurrent": {
      "type": "number",
      "unit": "mA",
      "min": 0,
      "default": 283,
      "description": "Wi-Fi TX 283 mA (802.11n HT20 MCS7 @18.5 dBm, Table 5-7)"
    },
    "supplyVoltage": {
      "type": "number",
      "unit": "V",
      "default": 3.3,
      "description": "내부 레귤레이터 출력 전압"
    },
    "batteryNominal": {
      "type": "number",
      "unit": "V",
      "default": 3.7,
      "description": "배터리 공칭 전압 (전류 환산용)"
    },
    "regulatorEfficiency": {
      "type": "number",
      "min": 0.1,
      "max": 1,
      "default": 0.9,
      "description": "전원관리 효율 (배터리 전류 = 부하 전류 × Vout / (Vbat × 효율))"
    },
    "wakeThreshold": {
      "type": "number",
      "unit": "V",
      "default": 1,
      "description": "이 전압 아래면 버튼이 눌린 것으로 본다"
    }
  },
