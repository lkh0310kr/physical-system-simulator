{
  "$schema": "../../../../schemas/model.schema.json",
  "id": "model.line-sensor",
  "name": "Line sensor (ideal)",
  "category": "electronics/sensor",
  "description": "바닥 선(사인 곡선)에서 앞 한 점이 옆으로 얼마나 벗어났는지(`offset`) 재는 이상 센서. 반사형 센서 어레이의 연속 값 근사이며 특정 제품이 아니다.",
  "propertySchema": {
    "lookAhead": {
      "type": "number",
      "unit": "m",
      "default": 0.12,
      "description": "차체 중심에서 센서 점까지 앞쪽 거리. 가정"
    },
    "amplitude": {
      "type": "number",
      "unit": "m",
      "default": 0.25,
      "description": "선의 진폭 (환경 가정)"
    },
    "wavelength": {
      "type": "number",
      "unit": "m",
      "min": 0.1,
      "default": 2,
      "description": "선의 파장 (환경 가정)"
    }
  },
  "properties": {},
  "ports": [
    {
      "name": "x",
      "domain": "signal",
      "direction": "in"
    },
    {
      "name": "y",
      "domain": "signal",
      "direction": "in"
    },
    {
      "name": "heading",
      "domain": "signal",
      "direction": "in"
    },
    {
      "name": "offset",
      "domain": "signal",
      "direction": "out",
      "description": "선에서 벗어난 옆 거리 [m] (선의 왼쪽이면 +)"
    }
  ],
  "capabilities": [
    {
      "capability": "capability.line-sensing"
    }
  ],
  "metadata": {
    "fidelity": "ideal",
    "assumptions": [
      "센서 점 한 개의 이상 측정(폭·노이즈·조명 없음)",
      "환경 선 모양(사인)은 센서 속성으로 둠"
    ]
  }
}
