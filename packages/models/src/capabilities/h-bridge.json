{
  "$schema": "../../../../schemas/capability.schema.json",
  "id": "capability.h-bridge",
  "name": "H-Bridge",
  "description": "신호(−1~1)로 모터 단자 A·B에 공급 전압을 PWM 듀티로 건다. 양수면 A가 +, 음수면 B가 +, 0이면 두 단자를 접지로 묶어 제동한다.",
  "outputs": {
    "duty": { "type": "number", "min": -1, "max": 1, "description": "현재 명령 (−1~1)" },
    "supplyCurrent": {
      "type": "number",
      "unit": "A",
      "description": "전원(VM)에서 끌어간 평균 전류"
    }
  },
  "defaultBehavior": "behavior.h-bridge"
}
