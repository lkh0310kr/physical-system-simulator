{
  "$schema": "../../../../schemas/capability.schema.json",
  "id": "capability.potentiometry",
  "name": "Potentiometry",
  "description": "양 끝 단자 사이를 와이퍼 위치에 따라 두 저항으로 나눈다.",
  "outputs": {
    "position": {
      "type": "number",
      "min": 0,
      "max": 1,
      "description": "와이퍼 위치 (0 = 단자 1쪽, 1 = 단자 3쪽)"
    }
  },
  "defaultBehavior": "behavior.potentiometer"
}
