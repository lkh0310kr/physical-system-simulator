{
  "$schema": "../../../../schemas/capability.schema.json",
  "id": "capability.gpio",
  "name": "GPIO",
  "description": "범용 디지털 입출력 핀. 프로그램이 pinMode/digitalWrite 이벤트로 제어하고, 출력 핀은 회로를 구동한다.",
  "parameters": {
    "pinCount": {
      "type": "integer",
      "min": 1
    },
    "logicLevel": {
      "type": "number",
      "unit": "V",
      "min": 0,
      "description": "HIGH 전압"
    },
    "pinPrefix": {
      "type": "string",
      "default": "D",
      "description": "핀 번호 n의 Port 이름은 pinPrefix + n"
    },
    "outputResistance": {
      "type": "number",
      "unit": "Ω",
      "min": 0,
      "default": 25,
      "description": "출력 핀 내부 저항"
    },
    "pullupResistance": {
      "type": "number",
      "unit": "Ω",
      "min": 0,
      "default": 20000,
      "description": "INPUT_PULLUP일 때 내부 풀업 저항 (ATmega328P 20~50kΩ)"
    }
  },
  "defaultBehavior": "behavior.digital-io"
}
