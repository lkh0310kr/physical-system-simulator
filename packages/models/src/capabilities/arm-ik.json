  "outputs": {
    "base": {
      "type": "number"
    },
    "shoulder": {
      "type": "number"
    },
    "elbow": {
      "type": "number"
    },
    "wrist": {
      "type": "number"
    },
    "reachable": {
      "type": "boolean",
      "description": "목표에 닿고 모든 관절이 한계 안인지"
    }
  },
  "defaultBehavior": "behavior.arm-ik"
}
