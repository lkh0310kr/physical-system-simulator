{
  "$schema": "../../../../schemas/capability.schema.json",
  "id": "capability.steering-mix",
  "name": "Steering Mixer",
  "description": "직진 명령과 조향 신호를 왼쪽·오른쪽 모터 명령으로 섞는다 (조향이 +면 왼쪽으로 돈다).",
  "outputs": {
    "left": { "type": "number", "min": -1, "max": 1, "description": "왼쪽 모터 명령" },
    "right": { "type": "number", "min": -1, "max": 1, "description": "오른쪽 모터 명령" }
  },
  "defaultBehavior": "behavior.steering-mixer"
}
