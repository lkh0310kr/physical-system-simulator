{
  "$schema": "../schemas/system.schema.json",
  "name": "Wearable Camera — Case B (ESP32-P4 + C6 + OV5640)",
  "description": "전용 카메라 SoC형: P4(하드웨어 ISP·JPEG) + C6(Wi-Fi 6) + OV5640. 값은 docs/scenarios/wearable-camera-specs.md 참조, 가정은 모델 metadata.assumptions.",
  "instances": [
    {
      "id": "bat",
      "model": "model.lipo-adafruit-1317"
    },
    {
      "id": "node",
      "model": "model.esp32-p4-c6-camera-node"
    },
    {
      "id": "btn",
      "model": "model.pushbutton"
    },
    {
      "id": "mcu",
      "model": "model.esp32-p4-qfn104"
    },
    {
      "id": "sensor",
      "model": "model.ov5640-sensor"
    },
    {
      "id": "wifi",
      "model": "model.esp32-c6-qfn32"
    }
  ],
  "connections": [
    ["bat:+", "node:VCC"],
    ["bat:-", "node:GND"],
    ["node:WAKE", "btn:1"],
    ["btn:2", "node:GND"]
  ],
  "layout": {
    "instances": {
      "bat": {
        "x": 0,
        "y": 0
      },
      "node": {
        "x": 160,
        "y": -20
      },
      "btn": {
        "x": 160,
        "y": -140
      }
    }
  },
  "assembly": {
    "bat": {
      "position": [0, 0, 1.9]
    },
    "mcu": {
      "position": [0, 0, 4.35]
    },
    "sensor": {
      "position": [0, -9, 4.8]
    },
    "node": {
      "position": [0, 0, 0.05]
    },
    "btn": {
      "position": [-14, 0, 2]
    },
    "wifi": {
      "position": [0, 9, 4.35]
    }
  }
}
