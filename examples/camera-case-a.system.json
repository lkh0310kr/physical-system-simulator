{
  "$schema": "../schemas/system.schema.json",
  "name": "Wearable Camera — Case A (ESP32-S3 통합형)",
  "description": "버튼 → 깨어남 → 촬영 → Wi-Fi 전송 → 절전. 배터리 500mAh. 동작 모델이므로 값은 근사치다 (docs/scenarios/wearable-camera.md).",
  "instances": [
    { "id": "bat", "model": "model.li-ion-cell", "properties": { "capacity": 500 } },
    { "id": "node", "model": "model.esp32-s3-camera-node" },
    { "id": "btn", "model": "model.pushbutton" }
  ],
  "connections": [
    ["bat:+", "node:VCC"],
    ["bat:-", "node:GND"],
    ["node:WAKE", "btn:1"],
    ["btn:2", "node:GND"]
  ],
  "layout": {
    "instances": {
      "bat": { "x": 0, "y": 0 },
      "node": { "x": 160, "y": -20 },
      "btn": { "x": 160, "y": -140 }
    }
  }
}
