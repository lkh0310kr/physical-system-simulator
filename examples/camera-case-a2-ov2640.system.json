{
  "$schema": "../schemas/system.schema.json",
  "name": "Wearable Camera — Case A-2 (ESP32-S3 + OV2640)",
  "description": "버튼 → 깨어남 → 촬영 → Wi-Fi 전송 → 절전. 전류는 데이터시트 값(docs/scenarios/wearable-camera-specs.md), 시간·파일 크기는 미확인 가정.",
  "instances": [
    {
      "id": "bat",
      "model": "model.lipo-adafruit-1317"
    },
    {
      "id": "node",
      "model": "model.esp32-s3-camera-node"
    },
    {
      "id": "btn",
      "model": "model.pushbutton"
    },
    {
      "id": "mcu",
      "model": "model.esp32-s3-qfn56"
    },
    {
      "id": "sensor",
      "model": "model.ov2640-sensor"
    }
  ],
  "connections": [
    ["bat:+", "node:VCC"],
    ["bat:-", "node:GND"],
    ["node:WAKE", "btn:1"],
    ["btn:2", "node:GND"]
  ],
  "layout": {
    "instances": {
      "bat": {
        "x": 0,
        "y": 0
      },
      "node": {
        "x": 160,
        "y": -20
      },
      "btn": {
        "x": 160,
        "y": -140
      }
    }
  },
  "assembly": {
    "bat": {
      "position": [0, 0, 1.9]
    },
    "mcu": {
      "position": [0, 2, 4.25]
    },
    "sensor": {
      "position": [0, -8, 4.8]
    },
    "node": {
      "position": [0, 0, 0.05]
    },
    "btn": {
      "position": [-14, 0, 2]
    }
  }
}
