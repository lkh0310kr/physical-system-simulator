{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^model\\.[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "propertySchema": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "number"
              },
              "unit": {
                "type": "string"
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "default": {
                "type": ["number", "string"]
              },
              "description": {
                "type": "string"
              }
            },
            "required": ["type"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "integer"
              },
              "min": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "max": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "default": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "description": {
                "type": "string"
              }
            },
            "required": ["type"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "boolean"
              },
              "default": {
                "type": "boolean"
              },
              "description": {
                "type": "string"
              }
            },
            "required": ["type"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "string"
              },
              "default": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "required": ["type"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "enum"
              },
              "options": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "default": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "required": ["type", "options"],
            "additionalProperties": false
          }
        ]
      }
    },
    "properties": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": ["number", "string", "boolean"]
      }
    },
    "body": {
      "type": "object",
      "properties": {
        "size": {
          "type": "array",
          "prefixItems": [
            {
              "type": ["number", "string"]
            },
            {
              "type": ["number", "string"]
            },
            {
              "type": ["number", "string"]
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "mass": {
          "type": "number",
          "minimum": 0
        },
        "mesh": {
          "type": "string",
          "minLength": 1
        },
        "color": {
          "type": "string"
        },
        "pins": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "port": {
                "type": "string",
                "minLength": 1
              },
              "position": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": ["number", "string"]
                  },
                  {
                    "type": ["number", "string"]
                  },
                  {
                    "type": ["number", "string"]
                  }
                ],
                "items": false,
                "minItems": 3,
                "maxItems": 3
              },
              "label": {
                "type": "string"
              }
            },
            "required": ["port", "position"],
            "additionalProperties": false
          }
        },
        "parts": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "shape": {
                    "type": "string",
                    "const": "box"
                  },
                  "position": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": ["number", "string"]
                      },
                      {
                        "type": ["number", "string"]
                      },
                      {
                        "type": ["number", "string"]
                      }
                    ],
                    "items": false,
                    "minItems": 3,
                    "maxItems": 3
                  },
                  "size": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": ["number", "string"]
                      },
                      {
                        "type": ["number", "string"]
                      },
                      {
                        "type": ["number", "string"]
                      }
                    ],
                    "items": false,
                    "minItems": 3,
                    "maxItems": 3
                  },
                  "material": {
                    "default": "plastic",
                    "type": "string",
                    "enum": ["pcb", "metal", "plastic", "glass", "rubber"]
                  },
                  "color": {
                    "type": "string"
                  },
                  "motion": {
                    "type": "object",
                    "properties": {
                      "signal": {
                        "type": "string",
                        "minLength": 1
                      },
                      "axis": {
                        "type": "string",
                        "enum": ["x", "y", "z"]
                      },
                      "distance": {
                        "type": ["number", "string"]
                      }
                    },
                    "required": ["signal", "axis", "distance"],
                    "additionalProperties": false
                  }
                },
                "required": ["name", "shape", "position", "size"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "shape": {
                    "type": "string",
                    "const": "cylinder"
                  },
                  "position": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": ["number", "string"]
                      },
                      {
                        "type": ["number", "string"]
                      },
                      {
                        "type": ["number", "string"]
                      }
                    ],
                    "items": false,
                    "minItems": 3,
                    "maxItems": 3
                  },
                  "diameter": {
                    "type": ["number", "string"]
                  },
                  "length": {
                    "type": ["number", "string"]
                  },
                  "axis": {
                    "default": "z",
                    "type": "string",
                    "enum": ["x", "y", "z"]
                  },
                  "material": {
                    "default": "plastic",
                    "type": "string",
                    "enum": ["pcb", "metal", "plastic", "glass", "rubber"]
                  },
                  "color": {
                    "type": "string"
                  },
                  "motion": {
                    "type": "object",
                    "properties": {
                      "signal": {
                        "type": "string",
                        "minLength": 1
                      },
                      "axis": {
                        "type": "string",
                        "enum": ["x", "y", "z"]
                      },
                      "distance": {
                        "type": ["number", "string"]
                      }
                    },
                    "required": ["signal", "axis", "distance"],
                    "additionalProperties": false
                  }
                },
                "required": ["name", "shape", "position", "diameter", "length"],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "required": ["size"],
      "additionalProperties": false
    },
    "mounts": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "position": {
            "type": "array",
            "prefixItems": [
              {
                "type": ["number", "string"]
              },
              {
                "type": ["number", "string"]
              },
              {
                "type": ["number", "string"]
              }
            ],
            "items": false,
            "minItems": 3,
            "maxItems": 3
          },
          "normal": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 3,
            "maxItems": 3
          },
          "description": {
            "type": "string"
          },
          "opening": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "shape": {
                    "type": "string",
                    "const": "round"
                  },
                  "diameter": {
                    "type": ["number", "string"]
                  }
                },
                "required": ["shape", "diameter"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "shape": {
                    "type": "string",
                    "const": "rect"
                  },
                  "width": {
                    "type": ["number", "string"]
                  },
                  "height": {
                    "type": ["number", "string"]
                  }
                },
                "required": ["shape", "width", "height"],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": ["name", "position"],
        "additionalProperties": false
      }
    },
    "ports": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.+-]+$"
          },
          "domain": {
            "type": "string",
            "enum": ["electrical", "mechanical", "signal"]
          },
          "ground": {
            "description": "true면 회로 기준 전위(0V)에 묶인다 (GND 핀).",
            "type": "boolean"
          },
          "direction": {
            "type": "string",
            "enum": ["in", "out"]
          },
          "description": {
            "type": "string"
          }
        },
        "required": ["name", "domain"],
        "additionalProperties": false
      }
    },
    "components": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "model": {
            "type": "string",
            "pattern": "^model\\.[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*$"
          }
        },
        "required": ["name", "model"],
        "additionalProperties": false
      }
    },
    "capabilities": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "capability": {
            "type": "string",
            "pattern": "^capability\\.[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*$"
          },
          "config": {
            "default": {},
            "description": "Capability parameters에 대한 이 Model의 값.",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": ["number", "string", "boolean"]
            }
          },
          "behavior": {
            "description": "Capability의 defaultBehavior 대신 쓸 Behavior ID.",
            "type": "string",
            "pattern": "^behavior\\.[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*$"
          }
        },
        "required": ["capability"],
        "additionalProperties": false
      }
    },
    "metadata": {
      "default": {},
      "type": "object",
      "properties": {
        "manufacturer": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "fidelity": {
          "type": "string",
          "enum": ["ideal", "approximate", "measured"]
        }
      },
      "additionalProperties": {}
    }
  },
  "required": ["id", "name", "category"],
  "additionalProperties": false
}
