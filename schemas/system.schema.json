{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "library": {
      "default": [],
      "description": "로컬 Model/Capability JSON 파일 경로 (이 문서 기준). 파일당 정의 1개.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "instances": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "model": {
            "type": "string",
            "pattern": "^model\\.[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*$"
          },
          "properties": {
            "default": {},
            "description": "Model 속성값 override. 숫자 또는 \"220Ω\" 같은 물리량 문자열.",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": ["number", "string", "boolean"]
            }
          },
          "program": {
            "description": "MCU 프로그램 JS 파일 (System 문서 기준 상대 경로). setup/loop, yield delay(ms).",
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["id", "model"],
        "additionalProperties": false
      }
    },
    "connections": {
      "default": [],
      "description": "두 Port를 잇는 선. 예: [\"uno:D13\", \"r1:1\"]",
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9_.+-]+$"
          },
          {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9_.+-]+$"
          }
        ],
        "items": false,
        "minItems": 2,
        "maxItems": 2
      }
    },
    "layout": {
      "description": "에디터용 화면 정보. 시뮬레이션에 영향 없음.",
      "type": "object",
      "properties": {},
      "additionalProperties": {}
    }
  },
  "required": ["name"],
  "additionalProperties": false
}
